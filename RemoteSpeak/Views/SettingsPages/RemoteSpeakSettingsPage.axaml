<ci:SettingsPageBase
    x:Class="RemoteSpeak.Views.SettingsPages.RemoteSpeakSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:local="clr-namespace:RemoteSpeak.Views.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance local:RemoteSpeakSettingsPage}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <!-- ===== HTTP 服务 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE4D0;}"
                                 Header="HTTP 服务"
                                 Description="网页往本机端口 POST 文本，插件立刻播报。"
                                 IsExpanded="True">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.HttpServiceEnabled, Mode=TwoWay}"
                                  OffContent="已关闭" OnContent="运行中" />
                </fa:SettingsExpander.Footer>

                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="只监听本机（localhost 与 127.0.0.1），其他设备连不上；网络怎么打通由调用方自己处理。关闭时完全不监听任何端口。开着的时候服务会自己保活：端口一时被别的程序占着、或者休眠唤醒后监听断了，都会按 1 秒到 15 秒的退避在后台自动重绑，占用方一让开就恢复，不用重启 ClassIsland。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="端口" Width="72" VerticalAlignment="Center" />
                        <fa:NumberBox x:Name="PortBox"
                                      Width="160"
                                      Minimum="1" Maximum="65535"
                                      SmallChange="1" LargeChange="10"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding Settings.HttpPort, Mode=TwoWay}" />
                        <TextBlock Text="默认 8765，被占用时换一个"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="访问 Token" Width="72" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Text="留空表示不校验；每条 Token 可以单独控制能不能播报、能不能取景。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Settings.Tokens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="160"
                                                 Text="{Binding Name, Mode=TwoWay}"
                                                 Watermark="名称，例如 互动页" />
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Content="启用" VerticalAlignment="Center" />
                                        <Button Content="复制" Click="ButtonCopyToken_OnClick" />
                                        <Button Content="删除" Click="ButtonDeleteToken_OnClick" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" FontFamily="Consolas,monospace"
                                               FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox IsChecked="{Binding AllowSpeak, Mode=TwoWay}"
                                                  Content="允许播报" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding AllowSnapshot, Mode=TwoWay}"
                                                  Content="允许取景" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UsageText}" FontSize="12"
                                                   Opacity="0.6" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Separator />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="新增 Token" Click="ButtonAddToken_OnClick" HorizontalAlignment="Left" />

                    <Separator Margin="0,4" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="状态" Width="72" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" IsVisible="False" />

                    <Button Content="复制调用示例" Click="ButtonCopyExample_OnClick"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 画面与朗读 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xED53;}"
                                 Header="画面与朗读"
                                 Description="一条播报分两段：先弹遮罩，再显示正文，朗读念的是正文。正文静止一行显示，不滚动。">
                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="遮罩文字" Width="116" VerticalAlignment="Center" />
                        <TextBox Width="240" Text="{Binding Settings.MaskText, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="遮罩时长（秒）" Width="116" VerticalAlignment="Center" />
                        <fa:NumberBox Width="140" Minimum="1" Maximum="30" SmallChange="1"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding Settings.MaskDurationSeconds, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="语速（字/秒）" Width="116" VerticalAlignment="Center" />
                        <fa:NumberBox Width="140" Minimum="1" Maximum="12" SmallChange="0.5"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding Settings.WordsPerSecond, Mode=TwoWay}" />
                        <TextBlock Text="只用来估算念完要多久"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="正文最长（秒）" Width="116" VerticalAlignment="Center" />
                        <fa:NumberBox Width="140" Minimum="5" Maximum="600" SmallChange="5"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding Settings.MaxSpeechDurationSeconds, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="重复遍数" Width="116" VerticalAlignment="Center" />
                        <fa:NumberBox Width="140" Minimum="1" Maximum="5" SmallChange="1"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding Settings.RepeatTimes, Mode=TwoWay}" />
                        <TextBlock Text="接口带了 repeat 就以接口为准"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="正文是静止的一行，不滚动：字比画面宽就只显示得下的一部分，末尾收成省略号，但会整句念完。停留时间按「字数 × 遍数 ÷ 语速 + 2 秒」估，再套上面的最长时间——画面一收宿主就清空语音队列，所以估短了会把句子截断，宁可放宽。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <TextBlock Text="重复遍数只改朗读的那份文本，画面上还是原文那一句（宿主把显示文本和朗读文本分成两个字段）。念完一遍接着念下一遍，中间靠句末标点断开；原文没带标点会补一个句号，只为停顿，画面看不到它。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 摄像头取景 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE722;}"
                                 Header="摄像头取景"
                                 Description="GET /snapshot 抓一帧本机摄像头画面，返回 JPEG。默认关闭。"
                                 IsExpanded="False">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SnapshotEnabled, Mode=TwoWay}"
                                  OffContent="已关闭" OnContent="已开启" />
                </fa:SettingsExpander.Footer>

                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="只监听本机，和播报共用同一个 Token；留空 Token 就等于本机任何程序都能取图。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="摄像头" Width="116" VerticalAlignment="Center" />
                        <ComboBox x:Name="DeviceComboBox" Width="300"
                                  SelectionChanged="DeviceComboBox_OnSelectionChanged" />
                        <Button Content="重新扫描" Click="ButtonRescanDevices_OnClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="出图尺寸" Width="116" VerticalAlignment="Center" />
                        <ComboBox x:Name="ResolutionComboBox" Width="160"
                                  SelectionChanged="ResolutionComboBox_OnSelectionChanged" />
                        <TextBlock Text="摄像头给不了这个尺寸时按等比缩放，不会拉伸"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="试拍一张" Click="ButtonTestSnapshot_OnClick" />
                        <Button Content="打开所在文件夹" Click="ButtonOpenSnapshotFolder_OnClick" />
                        <Button Content="删除试拍图" Click="ButtonDeleteSnapshot_OnClick" />
                    </StackPanel>

                    <TextBlock x:Name="SnapshotResultTextBlock"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="· 「试拍一张」走的就是接口那条路：开摄像头、等自动曝光稳定（丢掉前两张偏黑的）、缩放到上面的尺寸、编成 JPEG，约 1.3 秒。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="· 以共享方式读取，不会把摄像头从视频会议或直播手里抢走；代价是改不了摄像头正在出的尺寸。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="· 接口取走的那张不落盘——JPEG 在内存里编好直接写进 HTTP 响应，拍一百次硬盘上也不会多一个字节。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="· 只有「试拍一张」会写文件，固定那一张、每次覆盖（720 档约 227 KB）。不想让学生的脸留在机器上，点「删除试拍图」。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="· 开着头像上没有任何提示：不写角标、不加水印，宿主的摄像头指示灯该亮还是会亮。要不要在网页那边标一句「本教室画面已接入」，由调用方决定。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 没有声音先看这里 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE02F;}"
                                 Header="没有声音先看这里"
                                 Description="朗读走的是 ClassIsland 自己的语音引擎，由宿主的两个开关控制。">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <fa:InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                                Message="ClassIsland 出厂时就把「启用提醒语音」关着，不开只有画面、没有声音。" />
                    <TextBlock Text="① 设置 → 提醒 → 启用提醒语音：总开关，必须先打开。"
                               FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="② 设置 → 提醒 → 提醒管理 → 远程播报：如果在这里打开了「对此提醒来源启用特殊高级设置」，那么它以本条自己的「启用提醒语音」为准，而这个子开关默认是关的——开了高级设置却没勾它，这条播报同样没声音。不需要差异化就用全局开关，别开高级设置。"
                               FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="③ 播报内容本身：遮罩段不发声，正文段发声，避免同一句话念两遍。"
                               FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="念出来用的是宿主里选定的语音引擎和音色，本插件不再自带朗读通道。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 接口 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE61C;}"
                                 Header="接口"
                                 Description="GET /health 探活，POST /speak 播报，GET /snapshot 取景（默认关），OPTIONS 预检已放行。">
                <StackPanel Spacing="10" Margin="0,8,0,0">

                    <TextBlock Text="四个接口" FontSize="13" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="72,124,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GET" FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="/health" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="探活，回 { &quot;ok&quot;: true, &quot;name&quot;: &quot;远程播报&quot; }；不校验 Token"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="POST" FontSize="12" Opacity="0.75" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="/speak" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="播报。body 是 JSON：{ &quot;text&quot;: &quot;要被朗读的文本&quot;, &quot;repeat&quot;: 3 }；repeat 可选，1-5"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GET" FontSize="12" Opacity="0.75" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="/snapshot" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="取景，回一帧 image/jpeg；要先在「摄像头取景」里打开"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="OPTIONS" FontSize="12" Opacity="0.75" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="任意路径" FontSize="12" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="CORS 预检，回 204；已放行所有来源与 X-Token 头"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </Grid>

                    <TextBlock Text="返回码" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="44,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="200" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="健康检查通过，或者取景图" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="202" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="已受理——只代表进了队列，不代表念完了" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="400" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="text 为空、缺这个字段、repeat 不在 1-5，或者 body 不是合法 JSON" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="401" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Token 不对——上面填了 Token，请求就得带 X-Token 头" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="404" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="路径不存在，或者取景功能没开" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="405" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="方法不对：/speak 只收 POST，/snapshot 只收 GET" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="413" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="请求体超过 64 KB" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="503" FontSize="12" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="插件正在启动或停止，或者摄像头拍不出图——error 里写的是具体原因" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="500" FontSize="12" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="内部错误，error 里带异常类型和原文，同时也记进下面的日志" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="出错时 body 统一是 { &quot;ok&quot;: false, &quot;error&quot;: &quot;原因&quot; }；Content-Type 建议写 application/json; charset=utf-8。"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                    <TextBlock Text="行为说明" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="· 同一句可以连念几遍：接口的 repeat（1-5）优先，没写就用「画面与朗读」里的重复遍数；画面上只显示一次原文，念的是重复过的那份。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 新播报顶掉上一条：旧画面立刻收，念到一半的语音立刻掐，连发多条只有最后一条会念完。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 打断的范围比预期大：宿主的语音队列全局只有一条，掐的时候别的插件排队的朗读会一起清空。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 反过来，如果这一刻是别的提醒（比如上课提醒）正占着画面，本条排在它后面显示，语音随之延后。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 若 设置 → 提醒 里的「启用提醒」总开关是关的，画面会被直接丢弃，但接口照样回 202，不报错。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 取景那张图不落盘：JPEG 在内存里编好直接写进响应，调多少次硬盘都不会多一个字节。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="· 只监听本机，其他设备连不上；跨网怎么打通由调用方自己处理。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 日志 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7BA;}"
                                 Header="日志"
                                 Description="正常请求也记，最多 300 条，新的在最前面。"
                                 IsExpanded="True">
                <fa:SettingsExpander.Footer>
                    <TextBlock x:Name="LogCountTextBlock" Opacity="0.7" VerticalAlignment="Center" />
                </fa:SettingsExpander.Footer>

                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="记录正常请求" Width="104" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding Settings.LogRequests, Mode=TwoWay}"
                                      OffContent="只记错误" OnContent="全部记录" />
                        <TextBlock Text="关掉就退回只记错误；错误无论如何都留"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,8">
                        <ScrollViewer Height="280">
                            <StackPanel Spacing="4">
                                <ItemsControl x:Name="LogItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="LogEmptyTextBlock" Text="还没有记录。"
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="清空日志" Click="ButtonClearLog_OnClick" />
                        <Button Content="打开日志文件" Click="ButtonOpenLog_OnClick" />
                        <Button Content="打开 ClassIsland 日志目录" Click="ButtonOpenHostLogs_OnClick" />
                    </StackPanel>

                    <TextBlock x:Name="LogHintTextBlock"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="这里记的是插件自己看得见的：每条请求的方法、路径和状态码；播报多带字数和正文前 20 字，取景多带设备、尺寸、大小和耗时；Token 永远不进日志。念没念出声是另一码事——EdgeTTS 连不上、429、语音生成超时都发生在宿主的语音服务里，ISpeechService 不会把失败回调给插件，所以得点上面第三个按钮去 ClassIsland 的日志里查。" />
                </StackPanel>
            </fa:SettingsExpander>

            <!-- ===== 关于 ===== -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE0C1;}"
                                 Header="关于远程播报">
                <TextBlock Text="{Binding AboutText}"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
            </fa:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
